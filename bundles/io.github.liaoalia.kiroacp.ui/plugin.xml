<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <category id="io.github.liaoalia.kiroacp" name="Kiro"/>
      <view
            id="io.github.liaoalia.kiroacp.chat"
            name="Kiro Chat"
            icon="icons/kiro.png"
            category="io.github.liaoalia.kiroacp"
            class="io.github.liaoalia.kiroacp.ui.chat.ChatView"
            allowMultiple="true"
            restorable="true"/>
   </extension>
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="*">
         <view
               id="io.github.liaoalia.kiroacp.chat"
               relative="org.eclipse.ui.editorss"
               relationship="right"
               ratio="0.62"
               visible="true"/>
         <viewShortcut id="io.github.liaoalia.kiroacp.chat"/>
      </perspectiveExtension>
   </extension>
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="io.github.liaoalia.kiroacp.ui.prefs.KiroPreferenceInitializer"/>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="io.github.liaoalia.kiroacp.preferences"
            name="Kiro ACP Chat"
            class="io.github.liaoalia.kiroacp.ui.prefs.KiroPreferencePage">
         <keywordReference id="io.github.liaoalia.kiroacp.preferences.keywords"/>
      </page>
   </extension>
   <extension point="org.eclipse.ui.keywords">
      <keyword
            id="io.github.liaoalia.kiroacp.preferences.keywords"
            label="kiro acp agent chat cli terminal diff protocol log"/>
   </extension>
   <!-- A MessageConsole has no Close button of its own; closing one is how the user dismisses an agent terminal. -->
   <extension point="org.eclipse.ui.console.consolePageParticipants">
      <consolePageParticipant
            id="io.github.liaoalia.kiroacp.terminalConsoleParticipant"
            class="io.github.liaoalia.kiroacp.ui.services.TerminalConsoleParticipant">
         <enablement>
            <test property="org.eclipse.ui.console.consoleTypeTest" value="io.github.liaoalia.kiroacp.terminal"/>
         </enablement>
      </consolePageParticipant>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <category id="io.github.liaoalia.kiroacp.commands" name="Kiro"/>
      <command id="io.github.liaoalia.kiroacp.command.focusChat" name="Focus Kiro Chat" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.newSession" name="New Kiro Session" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.cancelTurn" name="Cancel Kiro Turn" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.restartAgent" name="Restart Kiro Agent Process" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.showLog" name="Show Kiro Protocol Log" categoryId="io.github.liaoalia.kiroacp.commands"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="io.github.liaoalia.kiroacp.command.focusChat" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.newSession" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.cancelTurn" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.restartAgent" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.showLog" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="toolbar:io.github.liaoalia.kiroacp.chat">
         <command commandId="io.github.liaoalia.kiroacp.command.newSession" label="New Session" style="push"/>
      </menuContribution>
      <menuContribution locationURI="menu:io.github.liaoalia.kiroacp.chat">
         <command commandId="io.github.liaoalia.kiroacp.command.cancelTurn" label="Cancel Current Turn" style="push"/>
         <command commandId="io.github.liaoalia.kiroacp.command.restartAgent" label="Restart Agent Process" style="push"/>
         <command commandId="io.github.liaoalia.kiroacp.command.showLog" label="Show Protocol Log" style="push"/>
      </menuContribution>
   </extension>
</plugin>
