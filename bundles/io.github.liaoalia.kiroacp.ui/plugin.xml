<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <category id="io.github.liaoalia.kiroacp" name="Kiro"/>
      <view
            id="io.github.liaoalia.kiroacp.chat"
            name="Kiro Chat"
            icon="icons/kiro.png"
            category="io.github.liaoalia.kiroacp"
            class="io.github.liaoalia.kiroacp.ui.chat.ChatView"
            allowMultiple="true"
            restorable="true"/>
   </extension>
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="*">
         <view
               id="io.github.liaoalia.kiroacp.chat"
               relative="org.eclipse.ui.editorss"
               relationship="right"
               ratio="0.62"
               visible="true"/>
         <viewShortcut id="io.github.liaoalia.kiroacp.chat"/>
      </perspectiveExtension>
   </extension>
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="io.github.liaoalia.kiroacp.ui.prefs.KiroPreferenceInitializer"/>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="io.github.liaoalia.kiroacp.preferences"
            name="Kiro ACP Chat"
            class="io.github.liaoalia.kiroacp.ui.prefs.KiroPreferencePage">
         <keywordReference id="io.github.liaoalia.kiroacp.preferences.keywords"/>
      </page>
   </extension>
   <extension point="org.eclipse.ui.keywords">
      <keyword
            id="io.github.liaoalia.kiroacp.preferences.keywords"
            label="kiro acp agent chat cli terminal diff protocol log"/>
   </extension>
   <!-- A MessageConsole has no Close button of its own; closing one is how the user dismisses an agent terminal. -->
   <extension point="org.eclipse.ui.console.consolePageParticipants">
      <consolePageParticipant
            id="io.github.liaoalia.kiroacp.terminalConsoleParticipant"
            class="io.github.liaoalia.kiroacp.ui.services.TerminalConsoleParticipant">
         <enablement>
            <test property="org.eclipse.ui.console.consoleTypeTest" value="io.github.liaoalia.kiroacp.terminal"/>
         </enablement>
      </consolePageParticipant>
   </extension>
   <!-- The plan of a session, read-only; opened by the chat, never for a file. -->
   <extension point="org.eclipse.ui.editors">
      <editor
            id="io.github.liaoalia.kiroacp.planEditor"
            name="Kiro Plan"
            icon="icons/kiro.png"
            class="io.github.liaoalia.kiroacp.ui.plan.PlanEditor"/>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <category id="io.github.liaoalia.kiroacp.commands" name="Kiro"/>
      <command id="io.github.liaoalia.kiroacp.command.focusChat" name="Focus Kiro Chat" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.newSession" name="New Kiro Session" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.cancelTurn" name="Cancel Kiro Turn" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.restartAgent" name="Restart Kiro Agent Process" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.login" name="Log In to Kiro" description="Sign in with the Kiro CLI in a terminal window, then reconnect the chat and bring its sessions back" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.showLog" name="Show Kiro Protocol Log" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.forgetSessionOptions" name="Forget Remembered Kiro Session Options" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.sendSelection" name="Send Selection to Kiro Chat" description="Attach the selected lines of the active editor to the next message of the Kiro chat" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.openPlan" name="Open Kiro Plan" description="Show the plan of the Kiro chat session used last in a read-only editor" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.approvePlan" name="Approve Kiro Plan" description="Let Kiro leave planning and start on the plan it proposed" categoryId="io.github.liaoalia.kiroacp.commands"/>
      <command id="io.github.liaoalia.kiroacp.command.rejectPlan" name="Reject Kiro Plan" description="Keep Kiro in planning" categoryId="io.github.liaoalia.kiroacp.commands"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="io.github.liaoalia.kiroacp.command.focusChat" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.newSession" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.cancelTurn" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.restartAgent" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.login" class="io.github.liaoalia.kiroacp.ui.auth.SignInHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.showLog" class="io.github.liaoalia.kiroacp.ui.handlers.ChatCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.forgetSessionOptions" class="io.github.liaoalia.kiroacp.ui.sessions.ForgetSessionOptionsHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.sendSelection" class="io.github.liaoalia.kiroacp.ui.context.SendSelectionHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.openPlan" class="io.github.liaoalia.kiroacp.ui.plan.PlanCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.approvePlan" class="io.github.liaoalia.kiroacp.ui.plan.PlanCommandHandler"/>
      <handler commandId="io.github.liaoalia.kiroacp.command.rejectPlan" class="io.github.liaoalia.kiroacp.ui.plan.PlanCommandHandler"/>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="toolbar:io.github.liaoalia.kiroacp.chat">
         <command commandId="io.github.liaoalia.kiroacp.command.newSession" label="New Session" style="push"/>
      </menuContribution>
      <menuContribution locationURI="menu:io.github.liaoalia.kiroacp.chat">
         <command commandId="io.github.liaoalia.kiroacp.command.cancelTurn" label="Cancel Current Turn" style="push"/>
         <command commandId="io.github.liaoalia.kiroacp.command.restartAgent" label="Restart Agent Process" style="push"/>
         <command commandId="io.github.liaoalia.kiroacp.command.login" label="Log In to Kiro" style="push"/>
         <command commandId="io.github.liaoalia.kiroacp.command.showLog" label="Show Protocol Log" style="push"/>
         <command commandId="io.github.liaoalia.kiroacp.command.forgetSessionOptions" label="Forget Remembered Session Options" style="push"/>
         <command commandId="io.github.liaoalia.kiroacp.command.openPlan" label="Open Plan" style="push"/>
      </menuContribution>
      <!-- The context menu of an editor whose selection is text. -->
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command commandId="io.github.liaoalia.kiroacp.command.sendSelection" label="Send Selection to Kiro Chat" style="push">
            <visibleWhen checkEnabled="false">
               <and>
                  <with variable="activePart">
                     <instanceof value="org.eclipse.ui.IEditorPart"/>
                  </with>
                  <with variable="selection">
                     <instanceof value="org.eclipse.jface.text.ITextSelection"/>
                  </with>
               </and>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>
   <!-- Ctrl+Alt+K (Cmd+Alt+K on a Mac) while typing in a text editor, as in the reference. -->
   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="io.github.liaoalia.kiroacp.command.sendSelection"
            contextId="org.eclipse.ui.textEditorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M3+K"/>
   </extension>
</plugin>
