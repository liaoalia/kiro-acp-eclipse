    </location>
    <location includeDependencyDepth="infinite" includeDependencyScopes="compile,runtime" includeSource="false" missingManifest="error" type="Maven">
      <dependencies>
        <dependency>
          <groupId>com.fasterxml.jackson.core</groupId>
          <artifactId>jackson-databind</artifactId>
          <version>2.17.2</version>
          <type>jar</type>
        </dependency>
